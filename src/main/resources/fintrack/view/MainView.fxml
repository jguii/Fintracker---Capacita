<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Tela principal: tabela de transações + resumo. Editável no Scene Builder. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fintrack.controller.MainController"
            prefWidth="1040.0" prefHeight="660.0" styleClass="raiz">

    <!-- ===================== TOPO: cabeçalho + barra de ferramentas ===================== -->
    <top>
        <VBox>
            <HBox styleClass="cabecalho" alignment="CENTER_LEFT" spacing="12.0">
                <VBox>
                    <Label styleClass="titulo-app" text="FinTrack"/>
                    <Label styleClass="subtitulo-app" text="Seu controle financeiro pessoal"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRelatorio" text="Relatório / Saldo" styleClass="botao-claro"
                        onAction="#onRelatorio"/>
            </HBox>

            <HBox styleClass="barra-ferramentas" alignment="CENTER_LEFT" spacing="8.0">
                <Button fx:id="btnNovaReceita" text="+ Receita" styleClass="botao-receita" onAction="#onNovaReceita"/>
                <Button fx:id="btnNovaDespesa" text="- Despesa" styleClass="botao-despesa" onAction="#onNovaDespesa"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="btnEditar" text="Editar" onAction="#onEditar" disable="true"/>
                <Button fx:id="btnRemover" text="Remover" styleClass="botao-perigo" onAction="#onRemover"
                        disable="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="chkMesAtual" text="Somente mês atual"/>
                <TextField fx:id="txtBusca" promptText="Buscar por descrição..." prefWidth="240.0"/>
                <Button text="Atualizar" onAction="#onAtualizar"/>
            </HBox>
        </VBox>
    </top>

    <!-- ===================== CENTRO: tabela + painel de detalhes ===================== -->
    <center>
        <HBox spacing="12.0">
            <BorderPane.margin>
                <Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/>
            </BorderPane.margin>

            <TableView fx:id="tabela" styleClass="tabela-transacoes" HBox.hgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colData" text="Data" prefWidth="105.0" minWidth="90.0" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="380.0" minWidth="180.0" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colValor" text="Valor" prefWidth="150.0" minWidth="110.0" styleClass="coluna-valor" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="150.0" minWidth="110.0" style="-fx-alignment: CENTER;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Nenhuma transação. Clique em &quot;+ Receita&quot; ou &quot;- Despesa&quot; para começar."
                           styleClass="placeholder"/>
                </placeholder>
            </TableView>

            <!-- Painel lateral de detalhes (abre ao selecionar uma linha) -->
            <VBox fx:id="painelDetalhes" styleClass="painel-detalhes" prefWidth="290.0" minWidth="260.0" maxWidth="320.0"
                  visible="false" managed="false" spacing="12.0">
                <!-- Cabeçalho do painel -->
                <HBox alignment="CENTER_LEFT">
                    <Label text="Detalhes da Transação" styleClass="titulo-painel-detalhes"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✕" styleClass="botao-fechar-detalhes" onAction="#onFecharDetalhes" focusTraversable="false"/>
                </HBox>

                <!-- Tags / Badges: Tipo e Recorrência -->
                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <Label fx:id="lblDetalheTipo" text="Receita" styleClass="badge-detalhe, badge-receita"/>
                    <Label fx:id="lblDetalheRecorrente" text="Mensal" styleClass="badge-detalhe, badge-recorrente" visible="false" managed="false"/>
                </HBox>

                <!-- Valor em destaque -->
                <VBox spacing="2.0">
                    <Label text="VALOR" styleClass="detalhe-campo-rotulo"/>
                    <Label fx:id="lblDetalheValor" text="R$ 0,00" styleClass="detalhe-valor"/>
                </VBox>

                <!-- Descrição -->
                <VBox spacing="2.0">
                    <Label text="DESCRIÇÃO" styleClass="detalhe-campo-rotulo"/>
                    <Label fx:id="lblDetalheDescricao" text="Descrição da transação" styleClass="detalhe-campo-valor" wrapText="true"/>
                </VBox>

                <!-- Data e Dia de Recorrência (se houver) -->
                <HBox spacing="16.0">
                    <VBox spacing="2.0">
                        <Label text="DATA" styleClass="detalhe-campo-rotulo"/>
                        <Label fx:id="lblDetalheData" text="01/01/2026" styleClass="detalhe-campo-valor"/>
                    </VBox>
                    <VBox fx:id="boxDetalheDia" spacing="2.0" visible="false" managed="false">
                        <Label text="DIA DO MÊS" styleClass="detalhe-campo-rotulo"/>
                        <Label fx:id="lblDetalheDia" text="Dia 5" styleClass="detalhe-campo-valor"/>
                    </VBox>
                </HBox>

                <Separator/>

                <!-- Observação -->
                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                    <Label text="OBSERVAÇÃO" styleClass="detalhe-campo-rotulo"/>
                    <ScrollPane fitToWidth="true" styleClass="scroll-observacao" VBox.vgrow="ALWAYS">
                        <VBox styleClass="caixa-observacao">
                            <Label fx:id="lblDetalheObservacao" text="Nenhuma observação informada."
                                   styleClass="observacao-texto" wrapText="true"/>
                        </VBox>
                    </ScrollPane>
                </VBox>
            </VBox>
        </HBox>
    </center>

    <!-- ===================== RODAPÉ: cartões de resumo ===================== -->
    <bottom>
        <HBox styleClass="rodape" alignment="CENTER_LEFT" spacing="12.0">
            <VBox styleClass="cartao, cartao-receita">
                <Label styleClass="cartao-titulo" text="Receitas"/>
                <Label fx:id="lblReceitas" styleClass="cartao-valor" text="R$ 0,00"/>
            </VBox>
            <VBox styleClass="cartao, cartao-despesa">
                <Label styleClass="cartao-titulo" text="Despesas"/>
                <Label fx:id="lblDespesas" styleClass="cartao-valor" text="R$ 0,00"/>
            </VBox>
            <VBox styleClass="cartao, cartao-saldo">
                <Label styleClass="cartao-titulo" text="Saldo atual"/>
                <Label fx:id="lblSaldo" styleClass="cartao-valor" text="R$ 0,00"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblStatus" styleClass="status" text=""/>
        </HBox>
    </bottom>
</BorderPane>
