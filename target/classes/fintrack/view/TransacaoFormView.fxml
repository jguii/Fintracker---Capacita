<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Formulário de nova transação / edição (receita ou despesa). -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fintrack.controller.TransacaoFormController"
      styleClass="raiz, formulario" spacing="16.0" prefWidth="520.0">

    <padding>
        <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
    </padding>

    <Label fx:id="lblTitulo" styleClass="titulo-formulario" text="Nova transação"/>

    <GridPane hgap="12.0" vgap="12.0">
        <columnConstraints>
            <ColumnConstraints minWidth="110.0" prefWidth="110.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Tipo -->
        <Label text="Tipo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <HBox spacing="18.0" alignment="CENTER_LEFT" GridPane.rowIndex="0" GridPane.columnIndex="1">
            <fx:define>
                <ToggleGroup fx:id="grupoTipo"/>
            </fx:define>
            <RadioButton fx:id="rbReceita" text="Receita" toggleGroup="$grupoTipo" styleClass="radio-receita"/>
            <RadioButton fx:id="rbDespesa" text="Despesa" toggleGroup="$grupoTipo" styleClass="radio-despesa"
                         selected="true"/>
        </HBox>

        <!-- Descrição -->
        <Label text="Descrição:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDescricao" promptText="Ex.: Salário, Aluguel, Mercado..."
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Valor -->
        <Label text="Valor (R$):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtValor" promptText="0,00" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- Data -->
        <Label text="Data:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpData" promptText="dd/mm/aaaa" maxWidth="Infinity"
                    GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <!-- Recorrência -->
        <Label text="Recorrência:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <HBox spacing="10.0" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1">
            <CheckBox fx:id="chkMensal" text="Repete todo mês, no dia"/>
            <Spinner fx:id="spDia" editable="true" prefWidth="80.0" disable="true"/>
        </HBox>

        <!-- Observação -->
        <Label text="Observação:" GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.valignment="TOP">
            <GridPane.margin>
                <Insets top="6.0"/>
            </GridPane.margin>
        </Label>
        <TextArea fx:id="txtObservacao" promptText="Opcional" prefRowCount="3" wrapText="true"
                  GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="lblErro" styleClass="mensagem-erro" wrapText="true" managed="false" visible="false"/>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCancelar" text="Cancelar" cancelButton="true" onAction="#onCancelar"/>
        <Button fx:id="btnSalvar" text="Salvar" defaultButton="true" styleClass="botao-primario"
                onAction="#onSalvar"/>
    </HBox>
</VBox>
